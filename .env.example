# ==============================================================================
# Gbé — Variables d'environnement
# ==============================================================================
# Copier ce fichier vers .env.local et remplir les valeurs.
# JAMAIS commit .env.local — seul .env.example est versionné.
# ==============================================================================

# ------------------------------------------------------------------------------
# Base de données — PostgreSQL via Supabase
# ------------------------------------------------------------------------------

# URL de connexion avec connection pooling (PgBouncer) — utilisée par l'app
# Format : postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:6543/postgres?pgbouncer=true"

# URL de connexion directe — utilisée par Prisma pour les migrations
# Format : postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# NextAuth.js v5 (Auth.js)
# ------------------------------------------------------------------------------

# URL complète de l'application (avec protocole, sans slash final)
# Dev : http://localhost:3000
# Prod : https://gbe.app (ou votre domaine)
NEXTAUTH_URL="http://localhost:3000"

# Secret utilisé pour signer les tokens et cookies Auth.js
# Générer avec : openssl rand -base64 32
NEXTAUTH_SECRET=""

# ------------------------------------------------------------------------------
# OAuth — Google Provider
# ------------------------------------------------------------------------------

# Obtenir depuis : https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# Emails — Resend
# ------------------------------------------------------------------------------

# Clé API Resend — obtenir depuis : https://resend.com/api-keys
# Commence toujours par "re_"
RESEND_API_KEY=""

# Adresse email expéditeur (doit être vérifiée dans Resend)
EMAIL_FROM="Gbé <noreply@gbe.app>"

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------

# URL publique de l'app (accessible côté client via NEXT_PUBLIC_)
# Utilisée pour les liens dans les emails, Open Graph, etc.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Supabase Storage (audio des adages)
# ------------------------------------------------------------------------------

# URL du projet Supabase — trouver dans : Settings > API
SUPABASE_URL="https://[PROJECT_REF].supabase.co"

# Clé service_role (accès complet, côté serveur uniquement)
# NE JAMAIS exposer côté client (pas de préfixe NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=""

# ------------------------------------------------------------------------------
# Vercel Cron (production uniquement)
# ------------------------------------------------------------------------------

# Secret pour sécuriser les endpoints cron
# Générer avec : openssl rand -base64 32
CRON_SECRET=""
